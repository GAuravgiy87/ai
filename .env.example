# ══════════════════════════════════════════════════════════════════════════════
# AI VIGILANCE - Environment Configuration
# Copy this file to .env and fill in your own values
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL Database Configuration ─────────────────────────────────────────
DB_USER=aiv_user
DB_PASSWORD=your_secure_password_here
DB_NAME=aiv_db

# ── Redis Cache Configuration ────────────────────────────────────────────────
REDIS_PASSWORD=redis_secure_pass_here

# ── Application Environment ─────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Optional: GPU Device Support (Linux only) ───────────────────────────────
# Enable GPU passthrough by uncommenting the device sections in docker-compose.yml
# GPU_DEVICE=/dev/dri:/dev/dri
