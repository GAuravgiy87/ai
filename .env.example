# ══════════════════════════════════════════════════════════════════════════════
# AI VIGILANCE — Environment Configuration
# Copy this file to .env and fill in your own values before running Docker.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USER=aiv_user
DB_PASSWORD=your_secure_db_password_here
DB_NAME=aiv_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=your_secure_redis_password_here

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Nginx ─────────────────────────────────────────────────────────────────────
# Port nginx binds on the host machine (default: 80)
NGINX_HTTP_PORT=80

# ── Optional: HTTPS port (requires SSL cert config in nginx.conf) ─────────────
# NGINX_HTTPS_PORT=443

# ── Optional: GPU Support (Linux only) ───────────────────────────────────────
# Uncomment device sections in docker-compose.yml for Intel VAAPI or NVIDIA GPU
# GPU_DEVICE=/dev/dri:/dev/dri
