# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyc
*.pyo
*.pyd
.Python

# ── Build / packaging ─────────────────────────────────────────────────────────
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
venv.bak/
env.bak/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & diagnostics ────────────────────────────────────────────────────────
*.log
*.log.*
database/logs/
crash_forensics.log

# ── Environment & secrets (NEVER commit) ─────────────────────────────────────
.env
.env.local
.env.*.local
.env.prod
secrets/
*.key
*.pem
*.p12
*.crt
*.cert

# ── Database files ────────────────────────────────────────────────────────────
data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal

# ── AI model weights ──────────────────────────────────────────────────────────
models/
*.pt
*.pth
*.onnx
*.tflite
*.h5
*.pb
*.pkl
*.joblib

# ── Runtime output directories ────────────────────────────────────────────────
database/
database/recordings/
database/snapshots/
database/dataset/

# Keep placeholder files so directories exist after clone
!database/recordings/.gitkeep
!database/snapshots/.gitkeep
!database/dataset/.gitkeep
!database/logs/.gitkeep

# ── OS / temp ─────────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.tar.gz
*.tar.bz2
*.dll
*.exe
*.dylib

# ── Media / uploads ───────────────────────────────────────────────────────────
# Ignore global video files
*.mkv
*.mp4
*.avi
*.webm

# (Optional) If you want to globally ignore images uncomment below,
# but it's usually better to ignore specific upload/media folders so static UI assets can be tracked.
# *.jpg
# *.jpeg
# *.png
# *.gif
# *.bmp
# *.webp
media/
uploads/
static/uploads/
static/media/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.tox/
.hypothesis/

# ── Type checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
